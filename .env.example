# Database
POSTGRES_DB=skills_db
POSTGRES_USER=skills_user
POSTGRES_PASSWORD=changeme_in_production

# Backend
JWT_SECRET=replace_with_64_char_random_string_here_minimum_32_chars
JWT_EXPIRES_IN=8h
NODE_ENV=production

# Email (SMTP) — leave blank to disable notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Skills Management

# Frontend build
REACT_APP_API_URL=/api/v1
